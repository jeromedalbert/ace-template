<div class="w-full">

  <div class="flex justify-between items-center mb-8">
    <h1 class="font-bold text-4xl"><%= human_name.pluralize %></h1>
    <%%= link_to "New <%= human_name.downcase %>", <%= new_helper(type: :path) %>, class: "rounded-lg py-3 px-5 bg-blue-600 text-white block font-medium" %>
  </div>

  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <%- attributes.each do |attribute| -%>
        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= attribute.human_name %></th>
        <%- end -%>
        <th scope="col" class="px-6 py-3 text-right"></th>
      </tr>
    </thead>

    <tbody>
      <%% @<%= plural_table_name%>.each do |<%= singular_table_name %>| %>
        <tr id="<%%= dom_id banana %>">
          <%- attributes.each do |attribute| -%>
          <td class="px-6 py-4"><%%= <%= singular_table_name %>.<%= attribute.name %> %></td>
          <%- end -%>
          <td class="pl-6 py-4 text-right font-medium">
            <%%= link_to "Show", <%= singular_table_name %>, class: "ml-2 rounded-lg py-2 px-4 bg-gray-100 inline-block font-medium" %>
            <%%= link_to "Edit", <%= edit_helper(singular_table_name, type: :path) %>, class: "ml-2 rounded-lg py-2 px-4 bg-gray-100 inline-block font-medium" %>
            <%%= link_to "Destroy", <%= singular_table_name %>, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "ml-2 rounded-lg py-2 px-4 bg-gray-100 inline-block font-medium" %>
          </td>
        </tr>
      <%% end %>
    </tbody>
  </table>

</div>
