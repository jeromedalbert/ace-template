<div class="row">
  <div class="col-md-4">

    <h1>Sign up</h1>

    <%= form_with model: @user, url: registrations_path, class: "contents" do |f| %>
      <div class="form-group">
        <%= f.label :email %>
        <%= f.email_field :email, autocomplete: 'username', class: 'form-control', value: params[:email] %>
      </div>

      <div class="form-group">
        <%= f.label :password %>
        <%= f.password_field :password, autocomplete: 'new-password', class: 'form-control' %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation %>
        <%= f.password_field :password_confirmation, autocomplete: 'new-password', class: 'form-control' %>
      </div>

      <div class="actions">
        <%= f.submit 'Sign up', class: 'btn btn-primary' %>
      </div>
    <% end %>

  </div>
</div>
