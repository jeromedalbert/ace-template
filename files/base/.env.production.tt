# Production environment variables used by Kamal.

SERVER_IP=<%= ENV['KAMAL_SERVER_IP'] %>

<% if postgresql? -%>
DB_HOST=$SERVER_IP
DB_NAME=<%= app_name %>_production
DB_USERNAME=<%= app_name %>
DB_PASSWORD=<%= SecureRandom.alphanumeric(32) %>
DATABASE_URL=postgres://$DB_USERNAME:$DB_PASSWORD@$DB_HOST:5432/$DB_NAME

<% end -%>
<% if redis? -%>
REDIS_HOST=$SERVER_IP
REDIS_PASSWORD=<%= SecureRandom.alphanumeric(32) %>
REDIS_URL=redis://:$REDIS_PASSWORD@$REDIS_HOST:6379

<% end -%>
KAMAL_REGISTRY_USERNAME=<%= ENV['KAMAL_REGISTRY_USERNAME'] %>
KAMAL_REGISTRY_PASSWORD=<%= ENV['KAMAL_REGISTRY_PASSWORD'] %>

<% if postgresql? -%>
POSTGRES_PASSWORD=$DB_PASSWORD
<% end -%>
SECRET_KEY_BASE=<%= SecureRandom.hex(64) %>
TIMEZONE=<%= timezone %>
