<% if dotenv? -%>
gem 'dotenv-rails'
<% end -%>
<% if factory_bot? -%>
gem 'factory_bot_rails'
<% end -%>
<% if ace_template_defaults? -%>
gem 'listen'
<% end -%>
<% if rspec? -%>
gem 'rspec-rails'
<% end -%>
<% if ace_template_defaults? && rubocop? -%>
# Use commit that fixes a CLI option while waiting for next version of rubocop and standard
gem 'rubocop', require: false, github: 'rubocop/rubocop', ref: '1e1df6f'
  <%- if factory_bot? -%>
gem 'rubocop-factory_bot', require: false
  <%- end -%>
  <%- if template_options[:rails_tests] -%>
gem 'rubocop-minitest', require: false
  <%- end -%>
gem 'rubocop-obsession', require: false
gem 'rubocop-performance', require: false
gem 'rubocop-rails', require: false
  <%- if rspec? -%>
gem 'rubocop-rspec', require: false
gem 'rubocop-rspec_rails', require: false
  <%- end -%>
gem 'rubocop-rubycw', require: false
<% end -%>
<% if ace_template_defaults? -%>
gem 'spring'
  <%- if rspec? -%>
gem 'spring-commands-rspec'
  <%- end -%>
  <%- if rubocop? -%>
gem 'spring-commands-rubocop'
  <%- end -%>
gem 'spring-watcher-listen'
  <%- if rubocop? -%>
gem 'standard'
gem 'standard-rails'
  <%- end -%>
gem 'syntax_tree'
<% end -%>
