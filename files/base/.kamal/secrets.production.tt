# Production environment variables used by Kamal.
<% if dotenv? -%>
# This file contains sensitive data and should not be committed.
<% else -%>
# This file should not contain sensitive data.
<% end -%>

SERVER_IP=<%= ENV['KAMAL_SERVER_IP'] %>

<% if template_options[:rails_creds] -%>
  <%- if any_kamal_creds? -%>
SECRETS=$(rails runner "puts Rails.application.credentials.to_json.inspect")
  <%- else -%>
# SECRETS=$(rails runner "puts Rails.application.credentials.to_json.inspect")
# MY_SECRET_1=$(kamal secrets extract my_secret_1 $SECRETS)
# MY_SECRET_2=$(kamal secrets extract my_secret_2 $SECRETS)
  <%- end -%>

<% end -%>
<% if server_db? -%>
DB_HOST=<%= app_name %>-db
DB_NAME=<%= app_name %>_production
DB_USERNAME=<%= app_name %>
  <%- if dotenv? -%>
DB_PASSWORD=<%= SecureRandom.alphanumeric(32) %>
  <%- else -%>
DB_PASSWORD=$(kamal secrets extract db_password $SECRETS)
  <%- end -%>
  <%- if postgresql? -%>
DATABASE_URL=postgres://$DB_USERNAME:$DB_PASSWORD@$DB_HOST:5432/$DB_NAME
  <%- elsif mysql? -%>
DATABASE_URL=mysql://$DB_USERNAME:$DB_PASSWORD@$DB_HOST:3306/$DB_NAME
  <%- else -%>
DATABASE_URL=TO_FILL
  <%- end -%>

<% end -%>
<% if Rails.version.to_f < 8.1 -%>
KAMAL_REGISTRY_USERNAME=
KAMAL_REGISTRY_PASSWORD=

<% end -%>
<% if mysql? -%>
MYSQL_ROOT_HOST=%
  <%- if dotenv? -%>
MYSQL_ROOT_PASSWORD=<%= SecureRandom.alphanumeric(32) %>
  <%- else -%>
MYSQL_ROOT_PASSWORD=$(kamal secrets extract mysql_root_password $SECRETS)
  <%- end -%>
MYSQL_DATABASE=$DB_NAME
MYSQL_USER=$DB_USERNAME
MYSQL_PASSWORD=$DB_PASSWORD

<% end -%>
<% if postgresql? -%>
POSTGRES_DB=$DB_NAME
POSTGRES_USER=$DB_USERNAME
POSTGRES_PASSWORD=$DB_PASSWORD

<% end -%>
<% if redis? -%>
REDIS_HOST=<%= app_name %>-redis
REDIS_USERNAME=default
  <%- if dotenv? -%>
REDIS_PASSWORD=<%= SecureRandom.alphanumeric(32) %>
  <%- else -%>
REDIS_PASSWORD=$(kamal secrets extract redis_password $SECRETS)
  <%- end -%>
REDIS_URL=redis://$REDIS_USERNAME:$REDIS_PASSWORD@$REDIS_HOST:6379

<% end -%>
RAILS_ENV=production
<% if template_options[:rails_creds] -%>
RAILS_MASTER_KEY=$(cat config/master.key)
<% end -%>
<% if template_options[:errors] == 'rollbar' && dotenv? -%>
ROLLBAR_ACCESS_TOKEN=
<% end -%>
<% if dotenv? -%>
SECRET_KEY_BASE=<%= SecureRandom.hex(64) %>
<% end -%>
<% if template_options[:errors] == 'sentry' && dotenv? -%>
SENTRY_DSN=
<% end -%>
<% if !skip_solid? -%>
SOLID_QUEUE_IN_PUMA=true
<% end -%>
TIMEZONE=<%= timezone %>
