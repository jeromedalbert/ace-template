<% if flash.any? %>
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-12">

        <% flash.each do |flash_name, flash_msg| %>
          <div
            class="alert alert-general
            alert-<%= ApplicationHelper::BOOTSTRAP_ALERT_CLASSES[flash_name] %>"
          >
            <%= flash_msg %>
          </div>
        <% end %>

      </div>
    </div>
  </div>
<% end %>
