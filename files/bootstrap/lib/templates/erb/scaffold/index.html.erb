<div class="row">
  <div class="col-md-12">

    <h1><%= human_name.pluralize %></h1>

    <table class="table table-striped table-bordered">
      <thead>
        <tr>
          <%- attributes.each do |attribute| -%>
          <th><%= attribute.human_name %></th>
          <%- end -%>
          <th></th>
        </tr>
      </thead>

      <tbody>
        <%% @<%= plural_table_name%>.each do |<%= singular_table_name %>| %>
          <tr id="<%%= dom_id <%= singular_table_name %> %>">
            <%- attributes.each do |attribute| -%>
            <td>
            <%- if attribute.attachment? -%>
              <%- if attribute.name.match?(/avatar|banner|image|logo|photo|picture/) -%>
              <%%= image_tag <%= singular_table_name %>.<%= attribute.column_name %>, class: 'attachment' if <%= singular_table_name %>.<%= attribute.column_name %>.attached? %>
              <%- else -%>
              <%%= link_to <%= singular_table_name %>.<%= attribute.column_name %>.filename, attribute if <%= singular_table_name %>.<%= attribute.column_name %>.attached? %>
              <%- end -%>
            <%- elsif attribute.attachments? -%>
              <%% <%= singular_table_name %>.<%= attribute.column_name %>.each do |<%= attribute.singular_name %>| %>
                <%- if attribute.name.match?(/avatar|banner|image|logo|photo|picture/) -%>
                <%%= image_tag <%= attribute.singular_name %>, class: 'attachment' %>
                <%- else -%>
                <div><%%= link_to <%= attribute.singular_name %>.filename, <%= attribute.singular_name %> %></div>
                <%- end -%>
              <%% end %>
            <%- else -%>
              <%%= <%= singular_table_name %>.<%= attribute.name %> %>
            <%- end -%>
            </td>
            <%- end -%>
            <td>
              <%%= link_to 'Show', <%= singular_table_name %> %>
              <%%= link_to 'Edit', <%= edit_helper(singular_table_name, type: :path) %> %>
              <%%= link_to 'Destroy', <%= singular_table_name %>, data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' } %>
            </td>
          </tr>
        <%% end %>
      </tbody>
    </table>

    <%%= link_to 'New <%= human_name.downcase %>', <%= new_helper(type: :path) %> %>

  </div>
</div>
