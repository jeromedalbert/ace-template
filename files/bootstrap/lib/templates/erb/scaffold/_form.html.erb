<%%= render partial: 'shared/base_errors', locals: { model: <%= model_resource_name %> } %>

<%%= form_with model: <%= model_resource_name %>, local: true do |form| %>
  <%- attributes.each do |attribute| -%>
  <div class="form-group">
    <%%= form.label :<%= attribute.column_name %> %>
    <%%= form.<%= attribute.field_type %> :<%= attribute.column_name %>, id: :<%= model_resource_name %>_<%= attribute.column_name %>, class: 'form-control' %>
  </div>

  <%- end -%>
  <div class="actions">
    <%%= form.submit class: 'btn btn-primary' %>
  </div>
<%% end %>
